<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TWLan Admin</title>
  <style>
    :root { color-scheme: light dark; --bg:#f4e4bc; --panel:#fff7e0; --ink:#2b1d08; --line:#c1a264; --accent:#7d510f; --warn:#a40000; }
    @media (prefers-color-scheme: dark) { :root { --bg:#1d1608; --panel:#2a2010; --ink:#f1e3c2; --line:#6b5320; --accent:#e0b45a; --warn:#ff7b6b; } }
    body { margin:0; background:var(--bg); color:var(--ink); font:14px/1.45 system-ui, sans-serif; }
    header { background:var(--accent); color:#fff; padding:10px 20px; display:flex; gap:20px; align-items:baseline; flex-wrap:wrap; }
    header a { color:#fff; text-decoration:none; padding:2px 8px; border-radius:3px; } header a.on { background:rgba(0,0,0,.25); }
    main { max-width:1100px; margin:20px auto; padding:0 16px; }
    table { width:100%; border-collapse:collapse; background:var(--panel); margin:10px 0; } th,td { border:1px solid var(--line); padding:5px 8px; text-align:left; } th { background:rgba(125,81,15,.18); }
    input,select,button { font:inherit; padding:3px 6px; } button,.btn { cursor:pointer; background:var(--accent); color:#fff; border:0; border-radius:3px; padding:4px 10px; }
    button.danger { background:var(--warn); } form.inline { display:inline; } .flash { background:var(--panel); border:1px solid var(--line); padding:8px 12px; margin-bottom:10px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:10px; } .card { background:var(--panel); border:1px solid var(--line); padding:10px; } .card b { font-size:22px; display:block; }
    code { background:rgba(0,0,0,.12); padding:1px 5px; border-radius:3px; }
  </style>
</head>
<body>
<header><strong>TWLan Admin</strong>
  <% for (const [slug, label] of pages) { %><a href="/admin/<%= slug %>" class="<%= (page === 'index' ? '' : page) === slug ? 'on' : '' %>"><%= label %></a><% } %>
  <span style="margin-left:auto"><a href="/page/play">Zum Spiel</a></span>
</header>
<main>
  <% if (typeof paused !== 'undefined' && paused) { %><div class="flash" style="border-color:var(--warn); color:var(--warn)"><b>⏸ Die Welt ist pausiert.</b> Spieler sehen eine Pause-Seite. <a href="/admin/world">Zur Welt-Seite</a></div><% } %>
  <% if (flash) { %><div class="flash"><%= flash %></div><% } %>
  <%- body %>
</main>
</body>
</html>
