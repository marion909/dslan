<% if (available.length) { %>
<form action="#" id="train_form" method="post">
  <table class="vis" style="width: 100%"><tbody>
    <tr>
      <th style="width: 25%"><%= t('game.unit') %></th>
      <th style="width: 40%"><%= t('buildingSmith.costs') %></th>
      <th><%= t('game.inVillage') %></th>
      <th style="width: 150px"><%= t('game.unit.recruit') %></th>
    </tr>
    <% for (const u of available) { %>
    <tr class="row_a">
      <td class="nowrap"><a href="/game.php?village=<%= vid %>&amp;screen=unit_info&amp;id=<%= u.id %>"><img src="/graphic/unit/recruit/<%= u.id %>.png" style="vertical-align: middle" alt=""> <%= unitName(u.id, 1) %></a></td>
      <td><div class="recruit_req">
        <% for (const r of physicalRes) { %><span><span class="icon header <%= r %>"> </span> <span id="<%= u.id %>_0_cost_<%= r %>"><%= u.cost[r] %></span></span> <% } %>
        <span><span class="icon header population"> </span> <span id="<%= u.id %>_0_cost_pop"><%= u.cost.population %></span></span>
        <span><span class="icon header time"> </span> <span id="<%= u.id %>_0_cost_time"><%= duration(u.time) %></span></span>
      </div></td>
      <td style="text-align: center"><%= u.count %>/<%= u.count %></td>
      <td>
        <span id="<%= u.id %>_0_interaction">
          <input name="<%= u.id %>" class="recruit_unit" id="<%= u.id %>_0" type="text" style="width: 50px; color: black;" maxlength="5" tabindex="1">
          <a id="<%= u.id %>_0_a" href="javascript:unit_build_block.set_max('<%= u.id %>')">(<%= u.max %>)</a>
        </span>
        <span id="<%= u.id %>_0_afford_hint" class="inactive" style="text-align: center; font-size: 11px;"></span>
      </td>
    </tr>
    <% } %>
    <tr><td colspan="3"></td><td><input class="btn btn-recruit" style="float: inherit" type="submit" value="<%= t('game.unit.recruit') %>" tabindex="4"></td></tr>
  </tbody></table>
</form>
<% } %>
<br>
<% if (unavailable.length) { %>
<table class="vis" style="width: 100%"><tbody>
  <tr><th style="width: 25%"><%= t('game.unit.notAvailable') %></th><th><%= t('buildingSmith.costs') %></th></tr>
  <% for (const u of unavailable) { %>
  <tr style="line-height: 30px">
    <td><a href="/game.php?village=<%= vid %>&amp;screen=unit_info&amp;id=<%= u.id %>"><img src="/graphic/unit/recruit/grey/<%= u.id %>.png" style="opacity: 0.7" alt=""> <%= unitName(u.id, 1) %></a></td>
    <td><div class="unmet_req float_left" style="width: 390px">
      <% for (const [b, l] of u.requirements) { %><span><span>
        <img src="/graphic/buildings/mid/<%= buildingImage(b, l) %>" style="vertical-align: middle" alt="">
        <span><%= buildingName(b) %> (<%= t('building.level', { x: l }) %>)</span>
      </span></span><% } %>
      <% if (u.needsResearch) { %><span class="float_right" style="margin-right: 5px"><img src="/graphic/overview/research.png" style="vertical-align: middle" alt="">&nbsp;<a href="/game.php?village=<%= vid %>&amp;screen=smith"><%= t('buildingSmith.research') %></a></span><% } %>
    </div></td>
  </tr>
  <% } %>
</tbody></table>
<% } %>
