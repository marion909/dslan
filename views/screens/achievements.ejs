<h2><%= t('game.menu.profile.achievements') %></h2>
<table class="vis" width="100%"><tbody>
  <tr><th>Erfolg</th><th>Stufe</th><th>Fortschritt</th></tr>
  <% for (const r of rows) { const pct = r.next ? Math.min(100, Math.round(100 * r.value / r.next)) : 100; %>
  <tr>
    <td><b><%= r.title %></b></td>
    <td><%= r.reached %> / <%= r.steps.length %></td>
    <td><div class="progress-bar"><span class="label"><%= number(r.value) %><%= r.next ? ' / ' + number(r.next) : '' %></span><div style="width:<%= pct %>%"></div></div></td>
  </tr>
  <% } %>
</tbody></table>
